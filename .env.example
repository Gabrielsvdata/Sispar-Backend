# ============================================
# ARQUIVO DE EXEMPLO - VARIÁVEIS DE AMBIENTE
# Copie para .env e preencha. O .env nunca vai para o Git.
# ============================================

# Ambiente: development | production | testing
FLASK_ENV=development

# Chave que assina os tokens de login. Em produção, use um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Banco de dados (Postgres). Em desenvolvimento, sem valor usa SQLite (dev.db).
# Neon: Dashboard > Connection string (com ?sslmode=require)
DATABASE_URL=

# IA (Groq): https://console.groq.com/keys
GROQ_API_KEY=
# Opcionais: modelos usados
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Origens do front liberadas no CORS, separadas por vírgula
# CORS_ORIGINS=https://sispar.pages.dev

# Modo demonstração: cria contas de visitante e libera /colaborador/login-demo
DEMO_MODE=false
